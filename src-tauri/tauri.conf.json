{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lutera varispeed",
  "version": "0.3.3",
  "identifier": "studio.lutera.varispeed",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "lūtera / varispeed",
        "width": 1470,
        "height": 920,
        "minWidth": 1010,
        "minHeight": 650,
        "backgroundColor": "#f7f4ed"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost blob:; connect-src ipc: http://ipc.localhost;",
      "devCsp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/wave-previews/*",
          "$APPCACHE/wave-previews/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
